/* Paper Element — USS (AC-42-C2: colors/sizes reference variables only; AC-42-C5: no hardcoded font-size) */

.paper {
    /* 2026-10-05 019-d 接图:引 border_paper-final.png(九宫格边框图,与下列 64px slice 匹配)。
       GUID 引用(非路径)—— 路径引用在资产移动时静默失联(casebook 移库即此失效模式)。
       🔴 **2026-11-04 订正(上一段的两条判断都不成立,原文不删)**:
       ① `url("guid:…")` 在 Unity 6.3 的 USS 导入器里被判 **Invalid URI scheme** ⇒
          该槽位从 2026-10-05 接图起**从未真正解析过**,纸纹一直是缺的;
       ② 相对路径**是**能用的 —— 已改 `url("Textures/border_paper-final.png")`,
          导入器零警告,`resolvedStyle.backgroundImage.sprite` = `border_paper-final`(实测)。
       「移动资产会失联」是真的代价,但 `guid:` 是**恒失联**,两害取轻。 */
    /* 🔁 **2026-11-04 纸面一分为二**(纹理一活就暴露的结构问题):
       `.paper` 在全仓既当**页/卡**用,也当**行**用(`CasebookScreen` 每行、`PauseScreen` 每行
       都是 `Create(SkeuoElement.Paper)`)。原 `border_paper-final.png` 把**三道黑框画在纸面里**,
       修好 `guid:` 之后每一行都套上一圈框 —— 实测暂停壳「继续」「存档位」各一个框,不可用。
       ⇒ `.paper` 只取**无框底纹**(`paper_hemp-final.png`,同批程序化产物,四边均匀、无文字);
       页框单独成类 `.paper-page`(见下方),只有「页 / 卡」级容器挂。 */
    background-image: url("Textures/paper_hemp-final.png");
    background-color: var(--skeuo-paper-bg);
    border-top-width: var(--skeuo-shared-border-width);
    border-right-width: var(--skeuo-shared-border-width);
    border-bottom-width: var(--skeuo-shared-border-width);
    border-left-width: var(--skeuo-shared-border-width);
    border-top-color: var(--skeuo-paper-border);
    border-right-color: var(--skeuo-paper-border);
    border-bottom-color: var(--skeuo-paper-border);
    border-left-color: var(--skeuo-paper-border);
    border-top-left-radius: var(--skeuo-shared-radius);
    border-top-right-radius: var(--skeuo-shared-radius);
    border-bottom-right-radius: var(--skeuo-shared-radius);
    border-bottom-left-radius: var(--skeuo-shared-radius);
    padding-top: var(--skeuo-shared-space-md);
    padding-right: var(--skeuo-shared-space-md);
    padding-bottom: var(--skeuo-shared-space-md);
    padding-left: var(--skeuo-shared-space-md);
    /* 2026-10-05 用户裁定(甲-B 口径):border_paper-final.png 重出后三道墨线实测落
       22–57px(四条边不对称,top 收 57 / left 收 51),slice 须 ≥ 最宽边才不被切。
       取 64px:接缝跳变 mean 4.00 ≈ 普通邻域梯度 4.61(等于无缝),占边 6.2%。
       旧值 42px 来自 2026-09-30 白框版(暗带 0–41px),该版已删,整行作废。
       ✅ 2026-10-08 冻结轮(019-f):64 维持 —— 掩膜法实测四边 40/39/43/43,ceil8=48,
       取 max(64, 48) = 64(两口径 43/57 均覆盖)。值真源 =
       design/assets/specs/nine-slice-freeze-2026-10-08.md(C8 门比对,禁手填)。 */
    -unity-slice-left: 64px;
    -unity-slice-right: 64px;
    -unity-slice-top: 64px;
    -unity-slice-bottom: 64px;
}

/* 变体: aged — 通过 USS 变量覆盖实现(禁止同类型内通过颜色/尺寸模拟变体, AC-42-C4) */
.paper-aged {
    /* 2026-10-05 019-d:旧纸态贴图。⚠️ 本类**不进 C7 判据面**
       (用户裁甲:变体类非注册项,门只查 4 基类)—— 接图靠人工守护,无门覆盖。 */
    background-image: url("Textures/paper_aged-final.png");
    background-color: var(--skeuo-paper-bg-aged);
}

/* 页框(2026-11-04 新立):纸 + 三道 3px 斜角墨线,九宫格 slice 64。
 * 只给「页 / 卡」级容器挂 —— **行不挂**(行贴边是正确形态,见 `.paper` 的注释)。
 * ⚠️ 与 `.paper` 是同一元素的**两个类**:`.paper` 供底色/边框/圆角/内边距/slice,
 *    本类只接管 `background-image`(文件内次序在本类之前的 `.paper` 之后 ⇒ 覆盖成立)。 */
.paper-page {
    background-image: url("Textures/border_paper-final.png");
    /* 内缩 = 墨线区外侧:内容不得压进框里(实测最内墨线外缘 38px)。 */
    padding-top: var(--skeuo-paper-frame-inset);
    padding-right: var(--skeuo-paper-frame-inset);
    padding-bottom: var(--skeuo-paper-frame-inset);
    padding-left: var(--skeuo-paper-frame-inset);
}

.paper .ink {
    color: var(--skeuo-ink-fg);
    -unity-font-definition: resource("Assets/Gameplay.UI/Skeuomorphic/Fonts/NotoSansCJKsc-Bold SDF.asset");
    font-size: var(--skeuo-font-size-md);
}

/* ── 线格 · M2 形态件①(story-021 · AC-021-1/2)──
 * art-bible §7.7:「字段由线格划出,不画成按钮」—— 行的字段感 = 底部一道淡墨线,
 * 零新图(承 story-020 冻结件:形态件① 不追加贴图,冻结轮不重开)。
 * `.ruled` = 有字行(脉案五行 + 问诊栏,CasebookScreen 挂载);
 * `.empty-row` = 空行(EmptyRowElement 唯一载体;存档空槽 SaveSlotItem 复用同语义)。
 * 两态**同格线同 min-height**(同一声明块)= 视觉等重的声明层(AC-021-2):
 * 下限 44 = AB-3 焦点落点 ≥44×44 的高半 ⇒ 空行塌陷不可能。
 * 线宽走 var(C4 门禁 `border-*-width:\s*\d+px` 硬编码)。 */
.ruled,
.empty-row,
.save-slot-item {
    border-bottom-width: var(--skeuo-shared-border-width);
    border-bottom-color: var(--skeuo-paper-rule);
    min-height: var(--skeuo-shared-row-height);
}

/* ── 模态窄列(2026-10-31 · 走查缺陷修复 · 首用 = 暂停壳)──
 * 病因(编辑器 Play 实拍 + 运行时布局 dump,`production/qa/evidence/ac42f1-pause-shell-walkthrough.md`):
 *   暂停壳的行原本铺满整个面板(1680 @参考分辨率),而焦点环是**贴在行内的 overlay,
 *   尺寸 = 行尺寸** ⇒ 环被拉成一条横贯全屏的铜带,读不出「焦点环住这一行」。
 * 处置:模态列给固定宽度 + 水平居中(父容器默认 column ⇒ cross 轴 = 水平 ⇒ align-self 居中)。
 * ⚠️ 数走 var(AC-42-C2 / C4 门禁 `width:\s*\d+px`);宽度权威 = `--skeuo-shared-modal-width`。 */
.pause-column {
    width: var(--skeuo-shared-modal-width);
    align-self: center;
}

/* 场景级屏的容器(2026-11-01 · `main-menu-42.md` §5)。
   ⚠️ 2026-11-01 实拍驱动补:第一版没这条,**纸面落在屏幕下方 2/3 处**
   (host 1680×96 at y=802,面板 1680×1215)—— 根因是容器高 = 内容高,
   `.menu-host` 的 `flex-grow` 在内容高盒子里没有可分配空间。
   ⇒ 容器绝对定位铺满面板(位置相对面板根,尺寸确定),居中才有意义。 */
.scene-host {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* 主菜单的**纯色背板**(2026-11-01 · `main-menu-42.md` §5「纸面下是纯色底,不是游戏画面」)。
   ⚠️ 色值 = 调色板既有 token `--skeuo-implement-bg`(用户 2026-11-01 裁定复用)——
   **本块不写字面色值**,美术轮改 token 时背板自动跟随。
   ⚠️ 绝对定位铺满 `.scene-host` 容器;绘制在纸面**之前**(兄弟次序 = 绘制次序)。 */
.menu-backdrop {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--skeuo-implement-bg);
}

/* 主菜单屏(2026-11-01 · `main-menu-42.md` §5)—— 与 `.pause-column` 同一条列宽契约,
   多一层「纵向也居中」:世界尚未装载,纸面下是纯色底,不需要贴边。 */
.menu-host {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.menu-column {
    width: var(--skeuo-shared-modal-width);
    align-self: center;
}

/* ── 跳过入口 · M2 形态件③(story-023 · AC-023-1/2/3)──
 * 判据权威 = art-bible G2(反数值化)+ emergency-procedures 规则六 / 规则六之甲。
 * **owner = 42**(ADR-013 §三 · `O-10-1`:10 不拥有任何 UI 元素,10 向 42 提规格)——
 * 跳过入口 = 候选动作列表上的一项(对 AC-3-F1a 零按键提示浮层兼容)。
 * ⚠️ 本 story **零施加点**:载体(候选动作列表)与 `Idle` 态可达时序归 **10 实现轮**
 * (规则六之甲状态机);此处只交形态对(同 story-022「形态半先立」先例)。
 * ⚠️ **焦点单槽铁律**(承 SkeuoFocusVisible.uss 头注):焦点目标只许 background-color 底,
 * 环图整槽替换会顶掉 background-image 纸纹 ⇒ 本类**零 background-image**;
 * 亦**零 border-***(与 .focus-visible 声明属性集零交集;.ruled 的 border 冲突是
 * story-021 已登记别案,本类不新增同类)。aged 纸底与主纸面区分 = 纸签叠纸,零新变量。
 * 零数字(AC-023-2):类块与全库 USS 零 `content:` 数字 / `X/N` 角标形态(G2 机械化)。 */
.skip-entry {
    background-color: var(--skeuo-paper-bg-aged);
    color: var(--skeuo-ink-fg);
    min-height: var(--skeuo-shared-row-height);
    padding-left: var(--skeuo-shared-space-sm);
    -unity-font-definition: resource("Assets/Gameplay.UI/Skeuomorphic/Fonts/NotoSansCJKsc-Bold SDF.asset");
    font-size: var(--skeuo-font-size-md);
}

/* ── 候选动作列表项 · M2 形态件③(sprint-05 T2.4 · EmergencyCandidateList 载体)──
 * 判据权威 = story-023 边界裁定①/警示②:`O-10-1` 跳过入口 owner = 42;
 * **跳过入口 = 候选动作列表上的一项**(规则六之甲)——候选列表本身归 10 轮,
 * 本类只承接**列表项**的宽半承诺(AB-3 ≥44×44:高半由 `.skip-entry` 锁,见上块;
 * 宽半 = 载体布局属性,story-023 已登记「由 10 轮候选动作列表载体锁定」——
 * 本轮 T2.4 建的载体即该锁定方,故在此承接,不越界承诺别处)。
 * ⚠️ 复用 `.skip-entry` 零 background-image / 零 border-* 的焦点单槽纪律
 *    (story-023 边界⑤;本类零新增属性冲突)。
 * ⚠️ 零数字(AC-023-2):本块零 `content:` / 零 `X/N` 形态。 */
.candidate-entry {
    min-width: var(--skeuo-shared-row-height);
}

/* ── 通道值区 · M2 形态件④(story-024 · AC-024-2)──
 * 一条真实状态反馈通道的**呈现端**:已查词条 → 脉案通道行的值区。
 * 判据权威 = diagnosis-system 规则五 / V-8.2 / :1178-1186。
 * 四态:未查 = **空行**(复用 `.empty-row`,:329 明文「不是 badge/灰字/占位符」——
 * 本批零新增未查态类)· 已查阳性 = `.channel-reading`(ink-fg 满墨)·
 * 已查阴性/读不出 = `.channel-reading-negative`(**墨色降档**,
 * :1185「把握不足只由承载形态传达,不以文字或标记出现」⇒ 零标注零徽章)。
 * ⚠️ 「体征 → 通道/词」映射归 8(`SignLexemeRow`);本处只画(SignChannelBinder 分发产物)。
 * 运行时挂行(值区元素创建)归 9 实现轮 / 数据绑定轮 —— **本批零施加点**(承 story-022/023)。
 *
 * ── sprint-08 S3 可读性 polish(2026-10-12)→ **2026-10-13 二轮修定** ──
 * 判据权威 = `accessibility-requirements.md:85`(纸面 UI ≥24px @1080p)+
 * `casebook-39.md:308/309/311`(最小字号 / 文本对比 ≥7:1 / 「阴性态用笔形不用低对比」)。
 * ① 字号 → `--skeuo-font-size-lexeme`(24px)—— 原 `md`(15px)低于无障碍下限;
 * ② 底衬 + ③ 阴性墨 —— 原 `ink-faded` 合成后 **3.87:1 < 7:1 承诺**,是本屏既有的一处
 *   违约(非本批引入)。⚠️ **二轮修定(2026-10-13 用户实测「发灰」判红)**:初值
 *    `backing #fbf9f3` + `negative #5a5044` = 7.48:1 贴线,且「靠明度差定界」有数学死结
 *    (浅底衬与纸纹不可辨 / 深底衬阴性墨破 7:1)⇒ **换机制**:底衬回纸色系加深
 *    (#e7e0cd)+ 阴性墨升档(#463b30,8.27:1)+ **边线定界**(`--skeuo-reading-rule`,
 *    承 story-021 格线美学)。现值实测与落选值记录见主题变量文件同族注。
 * ⚠️ 底衬是**新增属性**(原块无 `background-color`)⇒ 与「焦点单槽铁律」的关系:
 *   `.focus-visible` 走 `background-image`(环图),本二类走 `background-color`,
 *   **属性不重叠** ⇒ 不构成 story-023 边界⑤ 的单槽冲突。
 * ⚠️ **二轮新增边线与单槽铁律的关系**:边线走 `border-*-width/color`(四个方向属性),
 *   与 `background-color`(底衬)/ `background-image`(focus 环图 / ink 干湿)**三不重叠**
 *   ⇒ 仍不构成 story-023 边界⑤ 的单槽冲突。
 * ⚠️ 阳性类**不加**底衬外的第二槽:`ink-wet`/`ink-dry`(运行时叠加类)走
 *   `background-image`,同样与本处 `background-color` 不重叠。 */
.channel-reading {
    color: var(--skeuo-ink-fg);
    -unity-font-definition: resource("Assets/Gameplay.UI/Skeuomorphic/Fonts/NotoSansCJKsc-Bold SDF.asset");
    font-size: var(--skeuo-font-size-lexeme);
    background-color: var(--skeuo-reading-backing);
    border-top-width: var(--skeuo-shared-border-width);
    border-right-width: var(--skeuo-shared-border-width);
    border-bottom-width: var(--skeuo-shared-border-width);
    border-left-width: var(--skeuo-shared-border-width);
    border-top-color: var(--skeuo-reading-rule);
    border-right-color: var(--skeuo-reading-rule);
    border-bottom-color: var(--skeuo-reading-rule);
    border-left-color: var(--skeuo-reading-rule);
    /* 值区横排(2026-10-14):并列词条的水平间距(否则相邻边框贴边框)。 */
    margin-right: var(--skeuo-shared-space-sm);
}

.channel-reading-negative {
    color: var(--skeuo-ink-negative);
    -unity-font-definition: resource("Assets/Gameplay.UI/Skeuomorphic/Fonts/NotoSansCJKsc-Bold SDF.asset");
    font-size: var(--skeuo-font-size-lexeme);
    background-color: var(--skeuo-reading-backing);
    border-top-width: var(--skeuo-shared-border-width);
    border-right-width: var(--skeuo-shared-border-width);
    border-bottom-width: var(--skeuo-shared-border-width);
    border-left-width: var(--skeuo-shared-border-width);
    border-top-color: var(--skeuo-reading-rule);
    border-right-color: var(--skeuo-reading-rule);
    border-bottom-color: var(--skeuo-reading-rule);
    border-left-color: var(--skeuo-reading-rule);
    margin-right: var(--skeuo-shared-space-sm);
}

/* ── 通道题签(行头)· sprint-08 S3(2026-10-12)──
 * 权威 = `casebook-39.md:308`「**通道题签** / 落字 ≥24px @1080p」的**前半**(后半 = 上面的
 * `.channel-reading*`)。病因(2026-10-12 S3 探针实测):`CasebookScreen.AddChannel` 建行时
 * 行头 Label 是裸 `new Label(text)` **零 class** ⇒ 落到 **Unity 默认主题字号(实测 14.0px)**,
 * 既非本屏任何字号档、也不受主题变量管辖 —— 无障碍承诺对题签这一半**结构上无法兑现**。
 * 本类即该半的载体:挂 `--skeuo-font-size-lexeme` + 墨色。
 * ⚠️ 同族登记(S3 侦察,不在本批范围):`.ink` 类在**全部 7 个 UXML spec 文件**里被引用
 *   36 次(脉案 21 次),但**全仓运行期 C# 代码零挂载**(`SkeuoElement.Ink` 仅注册表登记)
 *   ⇒ spec 面描述的是一套运行期从不发生的呈现。系统性缺口,归独立 story。
 * ⚠️ 本类**不进 Registry**(语义样式类,承 `.channel-reading` 同款边界)。 */
.channel-label {
    color: var(--skeuo-ink-fg);
    -unity-font-definition: resource("Assets/Gameplay.UI/Skeuomorphic/Fonts/NotoSansCJKsc-Bold SDF.asset");
    font-size: var(--skeuo-font-size-lexeme);
    /* 值区横排(2026-10-14):题签与右侧首个词条之间的间距。 */
    margin-right: var(--skeuo-shared-space-md);
}

/* ══════════════════════════════════════════════════════════════════════════
 * 存档册(7b)—— 2026-11-04 · `TD-skeuo-07`
 *
 * 病因(图形模式实拍,`production/qa/evidence/walkthrough-7b-modal-toggle-2026-11-04.md`):
 *   ① 纸页此前是行的**兄弟**而不是行的父亲 ⇒ `.paper` 是空容器、高 = 自身内边距
 *      ⇒ 纸塌成顶部一条细带,行浮在没有底色的世界上;
 *   ② 行铺满整个面板、焦点环尺寸 = 行尺寸 ⇒ 环被拉成横贯全宽的铜带
 *      (与 `.pause-column` 2026-10-31 那条走查缺陷**同一个病**,处置同一条:定宽 + 居中);
 *   ③ `.save-slot-mark` / `.save-slot-page` / `.save-slot-edge` 三个类**此前零规则**
 *      ⇒ 行字走引擎默认色,在深色世界背景上读不出。
 *
 * 权威:`design/ux/save-slots-7b.md` §5.1(层级)/ §5.2(三区 + 页缘由纸边厚度传达)/
 *       §5.3(册面元件 · 九宫格 `-unity-slice-*`)。
 * ⚠️ 九宫格**复用** `.paper` 的冻结值(64px,真源 `nine-slice-freeze-2026-10-08.md`)——
 *   本批**不新出贴图**:仓内现成的纸纹件带生成水印(见 evidence §6),不能进构建。
 * ══════════════════════════════════════════════════════════════════════════ */

/* 册 = 定宽居中(承 `.pause-column` 的列宽契约:宽走 var,不写字面 px —— C4 门禁)。 */
.save-book {
    width: var(--skeuo-shared-modal-width);
    align-self: center;
    flex-direction: row;
    align-items: stretch;
}

/* 纸页 —— 行是它的子级。边框 / 底色 / 内边距 / 九宫格 slice 全部来自 `.paper`,此处只补「页是列」。 */
.save-page {
    flex-grow: 1;
    flex-direction: column;
    justify-content: flex-start;
    /* 页框内缩由 `.paper-page` 提供(它才是画框的那一层)—— 本类只管「页是列」。 */
}

/* 登记行:列容器里子元素默认 `stretch` ⇒ 行宽自然 = 页宽。
 * ⚠️ 这里**刻意不点名** `.save-slot-item` / `.empty-row` —— 二者已在上面那条
 *   「等重声明块」里各出现一次,而 `AC-021-2` 的门要求 `.empty-row` **恰出现一次**
 *   (反序块合并计,防后挂覆盖块让等重/格线运行期失守)。
 *   本轮实测:第一版在这里多点了一次名 ⇒ 该门当场 1 红。行宽交给容器 stretch 即可。 */

/* 行字(§5.4 字段一 + 字段二降级形态)。此前零规则 —— 这是「字读不出」的直接原因。
 *
 * ⚠️ **刻意不写 `-unity-font-definition`**:2026-11-04 实拍对比 —— 暂停壳的行标签是
 *   裸 `new Label(...)`(不指字体)⇒ 清晰;存档行原先硬指 `NotoSansCJKsc-Bold SDF`,
 *   同一张截图里**发虚带重影**。两屏同面板、同倍率、同字号量级 ⇒ 差异只在这行 override。
 *   ⇒ 与暂停壳对齐:字体交给主题默认,这里只定**颜色 / 字号 / 对齐 / 内边距**。 */
.save-slot-mark {
    color: var(--skeuo-ink-fg);
    font-size: var(--skeuo-font-size-md);
    -unity-text-align: middle-left;
    padding-left: var(--skeuo-shared-space-sm);
    padding-right: var(--skeuo-shared-space-sm);
}

/* 「留档」新行 —— 与槽位行**形态可分**(§5.3:玩家要能看出这一行是「再写一行」)。 */
.save-slot-writable {
    border-bottom-width: var(--skeuo-shared-border-width);
    border-bottom-color: var(--skeuo-brass-bg);
    min-height: var(--skeuo-shared-row-height);
    width: 100%;
}

/* 页脚页码(§5.2 封面区「当前页码 · 页脚鱼尾压印」的降级形态:一行居中小字)。 */
.save-slot-page {
    color: var(--skeuo-ink-fg-light);
    font-size: var(--skeuo-font-size-xs);
    -unity-text-align: middle-center;
    padding-top: var(--skeuo-shared-space-xs);
    padding-bottom: var(--skeuo-shared-space-xs);
}

/* 页缘热区(§5.2:指针点页缘 / 手柄把焦点移到页缘再 Submit;§5.1 序 4「还有下一页」
 * 由**纸边厚度**传达,不由图标传达)。故它是纸面的一条窄边,不是按钮。 */
.save-slot-edge {
    width: var(--skeuo-shared-space-lg);
    background-color: var(--skeuo-paper-bg-aged);
    border-top-width: var(--skeuo-shared-border-width);
    border-bottom-width: var(--skeuo-shared-border-width);
    border-top-color: var(--skeuo-paper-border);
    border-bottom-color: var(--skeuo-paper-border);
}

#save-slot-prev {
    border-right-width: var(--skeuo-shared-border-width);
    border-right-color: var(--skeuo-paper-border);
}

#save-slot-next {
    border-left-width: var(--skeuo-shared-border-width);
    border-left-color: var(--skeuo-paper-border);
}
