/* Theme Variables — Skeuomorphic UI Foundation (Story 001)
 * AC-42-C2: All USS colors/sizes/spacings MUST reference these variables.
 * AC-42-C5: No hardcoded px font-size or literal text in USS.
 * AC-42-C6: Fallback font stack registered in FallbackFontRegistry (zh + en).
 *
 * 命名约定: --skeuo-{layer}-{property}-{variant}
 *   layer  ∈ {paper, scroll, ink, seal, brass, implement, marks, focus, shared}
 *   property ∈ {bg, fg, border, shadow, radius, space, width, height, gap, rule}
 *
 * ⚠️ 2026-10-05(019-d 连带清理):layer 由 5 员扩至 9 员。
 *   brass / implement / marks / focus 四族此前**硬编码内联**(C4 红 44 条),
 *   本批抽变量消红 —— 权威出处 = **本文件 `:root` 块**(变量单一真源);
 *   清理轮记录见 production/epics/skeuomorphic-ui/story-019-texture-binding.md §Completion Notes。
 *   ⚠️ **brass-bg 取 art-bible §4.1 权威值 `#B8863B`**,订正 `SkeuoBrass.uss`
 *   原内联的 `#b87333`(绿通道差 19 —— 该值是网上通用「铜色」,非本项目裁定值)。
 */

:root {
    /* ── 纸面(Paper) ── */
    --skeuo-paper-bg: #f4ecd8;
    --skeuo-paper-bg-aged: #e8dcc4;
    --skeuo-paper-fg: #2b2416;
    --skeuo-paper-border: #a08c6c;
    --skeuo-paper-shadow: rgba(43, 36, 22, 0.18);
    /* 格线(rule)= 线格划线色(M2 形态件① · story-021)。同 paper-shadow 色系深一档。
       ⚠️ 【本稿提案值】art-bible 无格线专色 ⇒ 归数值轮,可调(AC-021-1 注记)。 */
    --skeuo-paper-rule: rgba(43, 36, 22, 0.35);

    /* ── 卷轴(Scroll) ── */
    --skeuo-scroll-bg: #f0e4c8;
    --skeuo-scroll-fg: #3a2e1c;
    --skeuo-scroll-border: #8c7355;
    --skeuo-scroll-rod: #5c4a32;
    --skeuo-scroll-rod-height: 6px;
    --skeuo-scroll-shadow: rgba(58, 46, 28, 0.22);

    /* ── 墨迹(Ink) ── */
    --skeuo-ink-fg: #1a1410;
    --skeuo-ink-fg-light: #3d3228;
    --skeuo-ink-faded: rgba(26, 20, 16, 0.55);
    /* ── 墨乾湿两态(story-022 · M2 形态件② · art-bible §4.5 墨龄)──
       湿 = §4.1 权威浓墨(非提案,可锚);干 = 同色相降明度(色沉)【提案·归数值轮】。
       两值只走明度轴不色相漂移(色盲安全 —— §4.5),由
       test_ac022_1_…luminance_axis_only 结构判据守(改色判据跟随,不锚具体 hex)。 */
    --skeuo-ink-fg-wet: #26241f;
    --skeuo-ink-fg-dry: #191714;

    /* ── 值区底衬 + 阴性墨(sprint-08 S3 · 2026-10-12 初版 → **2026-10-13 二轮修定**)──
       ⚠️ **本二值解决了既有的一处无障碍违约**(非 S3 引入,是 S3 撞见的):
       `--skeuo-ink-faded`(rgba 0.55)在纸面上合成后仅 **3.87:1**,而
       `accessibility-requirements.md:87` 与 `casebook-39.md:309` 均承诺墨字 ≥7:1,
       §11 更明文「阴性态用**笔形**不用低对比」。⇒ 阴性态改走本专用墨(不全局改
       `ink-faded` —— 那会波及全部 7 屏的淡墨观感,超出 S3 面;全局缺口另立 story)。

       **2026-10-13 二轮修定的动因(用户实测判红 · 「对比不足发灰」)**:初值
       `backing #fbf9f3` + `negative #5a5044` = 7.48:1 —— 数**合格但贴线**,而
       24px 大字 + Bold 下笔画并显 ⇒ 真机目视「发灰」。且初值有**数学死结**:
       底衬越浅阳墨越锐但与纸纹越不可辨(1.038:1 肉眼不可辨),底衬加深可辨了
       阴性墨即跌破 7:1 ⇒ 「靠明度差定界」这条路两头堵,不是调 hex 能解。
       **换机制:定界从「明度差」移到「边线」**(承 story-021「字段由线格划出,
       不画成按钮」同源美学),底衬回纸色系内加深一档。

       现值实测(线性 Rec.709,S3 判据同口径;纸纹中心取样 = border_paper 中心区均值 #fefdfe):
         · `--skeuo-reading-backing` #e7e0cd 上 `--skeuo-ink-negative` #463b30 = **8.27:1** ✓
           (超 ≥7:1 承诺 **18%** 冗余 —— 冗余是给「真机发灰」留的判红缓冲)
         · 同底衬上 `--skeuo-ink-fg` #1a1410 = **13.84:1** ✓
         · 底衬 vs 纸面 `--skeuo-paper-bg` #f4ecd8:Δ = **0.0947**(守 `skeuo_readability_test`
           `test_s3_4` 的 Δ≥0.02);vs 纸纹中心 #fefdfe:Δ = **0.238**(可辨)
         · ⚠️ 二轮间的**落选值 #f2ead8 已排除**:它在 `test_s3_4` 的 paper-bg 口径下
           Δ 仅 **0.0150 < 0.02** —— 会把自己判红,故不取;取 #e7e0cd。
       ⚠️ **阴性墨上界守卫(语义,非数值轮)**:不得深于 `#3d3228`(在本底衬上 9.46:1)。
       深过它则阴性/阳性的**墨阶差**消失,五态视觉分层破 —— 阴性态的存在意义是
       「降档可辨」,不是「变成正墨」。
       ⚠️ 全三值走**明度轴不漂色相**(色盲安全,承 `--skeuo-ink-fg-wet/dry` 同纪律):
       #e7e0cd 由 paper-bg 等比加深(r>g>b 暖黄关系不变)。
       底衬**只加在值区格**(.channel-reading*),不改纸面本身 —— 「墨在纸上」的质感保留。 */
    --skeuo-reading-backing: #e7e0cd;
    --skeuo-ink-negative: #463b30;
    /* 值区格定界边线(2026-10-13 二轮新增)── **几何定界**替代明度差定界
       (上面「换机制」的另一半)。色系承 `--skeuo-paper-rule` 同源(rgba(43,36,22,·));
       合成实测:在 paper-bg 上 = #c7c0ad(1.378:1)、在底衬上 = #bdb6a4(1.534:1)
       —— **淡到不抢字、深到看得见格**,不喧宾。
       ⚠️ 线宽**不另立 token**:走 `--skeuo-shared-border-width`(1px,已存在,
       承 `SkeuoImplement.uss` / `.paper` 同款先例)—— 边线要的是「色」的新机制,
       不是新宽度;另立宽 token 反违 AC-42-C4「零内联尺寸」的收敛方向。 */
    --skeuo-reading-rule: rgba(43, 36, 22, 0.22);

    /* ── 印章(Seal) ── */
    --skeuo-seal-bg: #8b2500;
    --skeuo-seal-fg: #f5e6d3;
    --skeuo-seal-border: #5c1a00;
    --skeuo-seal-border-width: 2px;
    --skeuo-seal-radius: 3px;
    --skeuo-seal-shadow: rgba(92, 26, 0, 0.35);

    /* ── 黄铜(Brass)— §1 P4 有来历之物;整体墨侧 / 还原铜侧 ── */
    --skeuo-brass-bg: #B8863B;              /* art-bible §4.1 权威值(订正 USS 原 #b87333) */
    --skeuo-brass-fg: #F5E6D3;
    --skeuo-brass-border: #8C5A2B;
    --skeuo-brass-aged: #A0653A;            /* ⚠️ 注:此值「铜锈」语义与 art-bible §4.1/§8.6.3 冲突
                                                (Bible 铜锈 = #4F7A6B 青绿);既有值,保值抽变量未改,待裁。 */
    --skeuo-brass-border-width: 1px;
    --skeuo-brass-scale-height: 2px;        /* 蚀刻刻度条 */
    --skeuo-brass-scale-gap: 2px;
    --skeuo-brass-scale-color: #8C5A2B;     /* 蚀刻刻度条底色 —— 与 border 解耦(评审 M4:
                                               描边语义 ≠ 实心蚀刻面语义,同值不同义,防调边连带改刻度) */

    /* ── 器具档(Implement)— 木/皮/铜 第三材质档(OQ-IC-4)── */
    --skeuo-implement-bg: #6B4423;
    --skeuo-implement-fg: #E8DCC4;
    --skeuo-implement-border: #4A2E18;
    --skeuo-implement-wood: #8B6914;        /* 木纹变体 */
    --skeuo-implement-leather: #7A4A2B;     /* 皮纹变体 */

    /* ── 记号(Marks)— 形状几何(尺寸走此族,非 shared-space)──
       ⚠️ 记号是**几何形状**非排版间距 ⇒ 不占 shared-space 语义位。 */
    --skeuo-marks-border-width: 1px;        /* 单折角线宽 */
    --skeuo-marks-border-width-double: 2px; /* 双线角 / 双叠角线宽 */
    --skeuo-marks-dot-size: 4px;            /* 点(陈旧) */
    --skeuo-marks-dot-radius: 2px;
    --skeuo-marks-fold-size: 6px;           /* 单折 / 双叠角尺寸 */
    --skeuo-marks-fold-double-size: 8px;    /* 双线角尺寸 */
    --skeuo-marks-seal-padding: 2px;        /* 印(计入/卸出)内衬 */

    /* ── 焦点(Focus)— 载体 = 黄铜 2px(2026-10-05 用户裁定,原墨侧)── */
    --skeuo-focus-border: #B8863B;          /* 同 brass-bg;独立命名以承「改判可溯源」;SkeuoFocusVisible.uss border-color 锚仍引用 */
    --skeuo-focus-border-width: 2px;        /* ⚠️ 2026-10-08 绑定轮起**无 USS 引用**(2px 形状由黄铜环图独挑,
                                               border 宽退役见 SkeuoFocusVisible.uss)—— 留作改判溯源,
                                               **勿当死变量删除**(删除须同批改 story-009 载体契约叙述) */

    /* ── 共享(Shared) ── */
    --skeuo-shared-radius: 2px;
    --skeuo-shared-border-width: 1px;
    /* 行高下限(M2 形态件① · story-021)= 44 = AB-3 焦点落点 ≥44×44 的高半
       (art-bible 无障碍承诺)—— 行即焦点落点,空行/有字行同下限 ⇒ 视觉等重(AC-021-2)。 */
    --skeuo-shared-row-height: 44px;
    --skeuo-shared-space-xs: 4px;
    --skeuo-shared-space-sm: 8px;
    --skeuo-shared-space-md: 16px;
    --skeuo-shared-space-lg: 24px;
    --skeuo-shared-space-xl: 32px;

    /* ── 字体(AC-42-C6 · 2026-10-12 修订 · 2026-10-13 语法/类型订正)──
       ⚠️ `font-family` 不是 UI Toolkit 的合法属性名(运行时抛
       "Unknown style property font-family" ⇒ Editor.log 红错刷屏,第五轮 playtest 实测)。
       UI Toolkit 唯一吃字体的属性 = `-unity-font-definition`(FontAsset 引用),
       且它**不能经 var() 间接承载**(变量只能存颜色/尺寸 token)⇒ 各 USS
       直接 `resource("Assets/…")` 引字体资产,不在本文件留字体变量。
       ⚠️ **2026-10-13 探针实证(糊的第二层根因)**:该属性吃 `resource("Assets/…路径")`,
       **不吃 `url("guid:…")`**(对字体恒不解析 ⇒ MissingAssetReference ⇒ 回退位图字体 ⇒ 糊;
       `url(guid:)` 仅对 `background-image` 有效)。全库 10 处字体引用已统一改 `resource`。
       字体资产 = Fonts/NotoSansCJKsc-Bold SDF.asset(**UnityEngine.TextCore.Text.FontAsset**,
       guid 6bfef9a30546ce4618445ebd7e0be0f5 —— 由 Editor.Tools.Font.SdfFontAssetTool 生成;
       ⚠️ 类型须 TextCore 系 —— `TMPro.TMP_FontAsset` 不继承它,被 UI Toolkit 拒绝;
       字形预烤后切 **Static**,material/atlas 子资产已 AddObjectToAsset 持久化;
       源 otf(guid b9b707bf05564101912cbf0f946b649f)保留不删,仅供生成器引用)
       —— 2026-10-12 第五轮复验:Regular 在纸纹底上笔画过细读不清(用户实测),
       整体切 Bold;Regular(guid 08d2bb8c…)留库备用。 */
    --skeuo-font-size-xs: 11px;
    --skeuo-font-size-sm: 13px;
    --skeuo-font-size-md: 15px;
    --skeuo-font-size-lg: 18px;
    --skeuo-font-size-xl: 22px;
    /* ── 纸面正文档(sprint-08 S3 · 2026-10-12)──
       ⚠️ **本档兑现 `accessibility-requirements.md:85` 的「纸面 UI ≥24px @1080p」下限**
       (该行状态原为 `Not Started`,落点即本主题变量集;`casebook-39.md:308` 同承诺)。
       病因:原有 5 档上限 `xl = 22px` **物理上够不到 24px** ⇒ 该承诺自订立起全族从未满足。
       24px 是**无障碍承诺值**(非数值轮提案),故可锚、不归数值轮。
       ⚠️ **只挂 42 脉案的题签与落字**(casebook-39 §11 的两半),不全局替换 `md` ——
       其余 6 屏的字号档归各自 polish 轮,不随本档漂移。
       实测(2026-10-12 S3 探针):题签原 **14.0px**(Unity 默认主题,因代码面行头 Label
       零 class —— 见 `.channel-label` 注)、落字原 15.0px(`md`)。

       ⭑ **2026-10-13 用户裁定「24px 偏小,再调大」→ 28px**(承 accessibility-requirements.md:85
       的「≥24px」是**下限**语义:上抬不违约,下才违约):
       · **占屏实测**:`casebook-39.md:353` 记「24px ⇒ 行高 ≈66.8px」**漏算 `.paper`
         四向 padding(16×2=32)也作用于行** —— 真实行高 = max(字盒 34.8, min-height 44)
         + padding 32 + 边框 2 = **78.0px**;GDD 该数就地订正见 :353 复评注。
       · **28px 不涨行高**:字盒 40.5 < min-height 44 ⇒ 仍被 44 顶着 ⇒ 行高恒 78.0px
         ⇒ §5.2「空行/已查行等重」**不动自守**(gap 恒 0;32px 起才 2.3px)。
       · **⚠️ 768p 视口的等效折算(动因)**:`ProjectSettings.asset:45-46` 默认
         1024×768(`fullscreenMode: 3` Windowed)⇒ 28px@768 仅等效 1080p 下的 21px,
         **仍低于承诺基准**;调字号只是矮视口的**补偿**,不是回归设计意图(同批已决议
         走「默认分辨率 → 1920×1080」的正解,见 ProjectSettings 改动注)。
       · 32px 起等重合口径开始破(gap 2.3px)⇒ 若未来再升档,须同批抬 `.empty-row`
         的 min-height(现共享 44 ⇒ 拆出行专属 min-height = 字盒值 41/46),本注即前置。 */
    --skeuo-font-size-lexeme: 28px;

    /* ── 全局默认字号(B-6-4 字体糊根治 · 2026-10-13)──
       ⚠️ **根因(用户实证)**:SDF 资产采样点 = 32px(`m_PointSize`);Unity 主题默认
       字号 ≈14px **远低于采样点** ⇒ SDF 缩采样不足 = **糊**。用户实验确证:字号抬到
       40px 即清晰 ⇒ 根因是**字号过小**,非渲染。
       取值 **28px** —— 与 `--skeuo-font-size-lexeme` 同值,是**已被验证清晰**的档
       (题签 `.channel-label` = 28px,用户首轮即认可「6 行清晰」),且接近采样点 32px。
       供 `.unity-text-element` 兜底用 —— **只兜无自己字号的文本**(运行期裸 Label:
       `?`/折/前案/后案/方笺/值区子 Label/急救候选子 Label);挂类元素(如 `.channel-label`)
       自带同值字号,同特异性后加载,零冲突。 */
    --skeuo-font-size-default: 28px;

    /* ── 过渡 ── */
    --skeuo-transition-fast: 120ms;
    --skeuo-transition-normal: 220ms;
    --skeuo-transition-slow: 360ms;
}

/* ── 全局默认字体(B-6-4 字体糊根治 · 2026-10-13)──
   病因:运行期 C# 建的裸 `new Label(text)` **零类** ⇒ 落 Unity 默认主题字体
   (中文 fallback = 糊)。真机实测(2026-10-13)确证根因**不是「没设字体」,而是
   「继承被直接规则压过」**:
     · 清晰 = `.channel-label`(**直接**挂在 Label 上的类);
     · 糊   = 全部**靠继承**拿字体的元素(`?`/折/前案/后案/方笺 = 裸 Label;
              「止血」等 = `.skip-entry` 容器内的子 Label)。
   CSS 级联铁律:**元素上的直接声明恒压继承值**(与特异性无关)。Unity 默认主题
   对文本元素有**直接**字体规则 ⇒ 压过从祖先继承下来的值。
   ⇒ 修法:用 `.unity-text-element`(UI Toolkit 给**每个** TextElement/Label/Button/
   TextField 自动挂的类)**直接匹配**所有文本元素 —— 不赌继承,直接竞争。
   ⚠️ **加载序**:本文件是九份 USS 清单**第一位**(Boot.unity `_styleSheets`),而
   `.ink`(SkeuoInk)/`.channel-label`(SkeuoPaper)等**逐元素类在其后**加载 ⇒
   同特异性下后者胜出 ⇒ 那些类的**专属字体 / 色 / 字号仍照常生效**,零冲突。
   ⚠️ 主题(`unity-theme://default`,PanelSettings.themeUss)在元素 styleSheets
   **之前**应用 ⇒ 本规则压过主题默认字体。
   ⚠️ 本规则设**字体 + 兜底字号**(`--skeuo-font-size-default` = 28px,即第二根因的修法);
   **不设 color** —— 逐元素类仍可覆盖色与字号(同特异性下后加载者胜)。 */
.unity-text-element {
    -unity-font-definition: resource("Assets/Gameplay.UI/Skeuomorphic/Fonts/NotoSansCJKsc-Bold SDF.asset");
    /* ⚠️ **字号是糊的第二根因(B-6-4 · 2026-10-13 用户实证定稿)**:
       SDF 资产采样点 = 32px(`m_PointSize`),清晰档 `.channel-label` = 28px(近采样点);
       而糊的裸 Label 无字号 ⇒ 落主题默认 ≈14px(**远小于采样点**)⇒ SDF 缩采样不足 = 糊。
       用户诊断实验:字号抬到 40px ⇒ **字变大且变清晰** ⇒ 根因 = 字号过小(非渲染)。
       定稿 **28px**(= `--skeuo-font-size-default`,与题签同档、近采样点、已被验证清晰)。
       ⚠️ 逐元素类(`.ink` / `.channel-label` / `.channel-reading` 等)在本规则**之后**加载 ⇒
       同特异性下胜出 ⇒ 它们各自的字号仍照常生效,本规则只兜**无字号的裸 Label**。 */
    font-size: var(--skeuo-font-size-default);
}
