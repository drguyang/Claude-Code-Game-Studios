/* Scroll Element — USS (AC-42-C2 / AC-42-C5) */

.scroll {
    /* 2026-10-05 019-d 接图:引 border_scroll-final.png(九宫格边框图,与下列 68px slice 匹配)。 */
    background-image: url("guid:1c689262fb8fba66badc6204cda03478");
    background-color: var(--skeuo-scroll-bg);
    border-top-width: var(--skeuo-shared-border-width);
    border-right-width: var(--skeuo-shared-border-width);
    border-bottom-width: var(--skeuo-shared-border-width);
    border-left-width: var(--skeuo-shared-border-width);
    border-top-color: var(--skeuo-scroll-border);
    border-right-color: var(--skeuo-scroll-border);
    border-bottom-color: var(--skeuo-scroll-border);
    border-left-color: var(--skeuo-scroll-border);
    padding-top: var(--skeuo-shared-space-lg);
    padding-right: var(--skeuo-shared-space-lg);
    padding-bottom: var(--skeuo-shared-space-lg);
    padding-left: var(--skeuo-shared-space-lg);
    -unity-slice-left: 68px;
    -unity-slice-right: 68px;
    -unity-slice-top: 68px;
    -unity-slice-bottom: 68px;
}

.scroll .ink {
    color: var(--skeuo-scroll-fg);
    font-family: var(--skeuo-font-family);
    font-size: var(--skeuo-font-size-md);
}

/* 卷轴杆(纯装饰,不承载文本) */
.scroll-rod {
    background-color: var(--skeuo-scroll-rod);
    height: var(--skeuo-scroll-rod-height);
    margin-top: var(--skeuo-shared-space-sm);
    margin-bottom: var(--skeuo-shared-space-sm);
}
