/* Paper Element — USS (AC-42-C2: colors/sizes reference variables only; AC-42-C5: no hardcoded font-size) */

.paper {
    /* 2026-10-05 019-d 接图:引 border_paper-final.png(九宫格边框图,与下列 64px slice 匹配)。
       GUID 引用(非路径)—— 路径引用在资产移动时静默失联(casebook 移库即此失效模式)。 */
    background-image: url("guid:9c7bc40f300a2c5539a0dfece9d9e43b");
    background-color: var(--skeuo-paper-bg);
    border-top-width: var(--skeuo-shared-border-width);
    border-right-width: var(--skeuo-shared-border-width);
    border-bottom-width: var(--skeuo-shared-border-width);
    border-left-width: var(--skeuo-shared-border-width);
    border-top-color: var(--skeuo-paper-border);
    border-right-color: var(--skeuo-paper-border);
    border-bottom-color: var(--skeuo-paper-border);
    border-left-color: var(--skeuo-paper-border);
    border-top-left-radius: var(--skeuo-shared-radius);
    border-top-right-radius: var(--skeuo-shared-radius);
    border-bottom-right-radius: var(--skeuo-shared-radius);
    border-bottom-left-radius: var(--skeuo-shared-radius);
    padding-top: var(--skeuo-shared-space-md);
    padding-right: var(--skeuo-shared-space-md);
    padding-bottom: var(--skeuo-shared-space-md);
    padding-left: var(--skeuo-shared-space-md);
    /* 2026-10-05 用户裁定(甲-B 口径):border_paper-final.png 重出后三道墨线实测落
       22–57px(四条边不对称,top 收 57 / left 收 51),slice 须 ≥ 最宽边才不被切。
       取 64px:接缝跳变 mean 4.00 ≈ 普通邻域梯度 4.61(等于无缝),占边 6.2%。
       旧值 42px 来自 2026-09-30 白框版(暗带 0–41px),该版已删,整行作废。
       ✅ 2026-10-08 冻结轮(019-f):64 维持 —— 掩膜法实测四边 40/39/43/43,ceil8=48,
       取 max(64, 48) = 64(两口径 43/57 均覆盖)。值真源 =
       design/assets/specs/nine-slice-freeze-2026-10-08.md(C8 门比对,禁手填)。 */
    -unity-slice-left: 64px;
    -unity-slice-right: 64px;
    -unity-slice-top: 64px;
    -unity-slice-bottom: 64px;
}

/* 变体: aged — 通过 USS 变量覆盖实现(禁止同类型内通过颜色/尺寸模拟变体, AC-42-C4) */
.paper-aged {
    /* 2026-10-05 019-d:旧纸态贴图。⚠️ 本类**不进 C7 判据面**
       (用户裁甲:变体类非注册项,门只查 4 基类)—— 接图靠人工守护,无门覆盖。 */
    background-image: url("guid:3ebbce0eca27f8999856715176f08e4d");
    background-color: var(--skeuo-paper-bg-aged);
}

.paper .ink {
    color: var(--skeuo-ink-fg);
    font-family: var(--skeuo-font-family);
    font-size: var(--skeuo-font-size-md);
}

/* ── 线格 · M2 形态件①(story-021 · AC-021-1/2)──
 * art-bible §7.7:「字段由线格划出,不画成按钮」—— 行的字段感 = 底部一道淡墨线,
 * 零新图(承 story-020 冻结件:形态件① 不追加贴图,冻结轮不重开)。
 * `.ruled` = 有字行(脉案五行 + 问诊栏,CasebookScreen 挂载);
 * `.empty-row` = 空行(EmptyRowElement 唯一载体;存档空槽 SaveSlotItem 复用同语义)。
 * 两态**同格线同 min-height**(同一声明块)= 视觉等重的声明层(AC-021-2):
 * 下限 44 = AB-3 焦点落点 ≥44×44 的高半 ⇒ 空行塌陷不可能。
 * 线宽走 var(C4 门禁 `border-*-width:\s*\d+px` 硬编码)。 */
.ruled,
.empty-row {
    border-bottom-width: var(--skeuo-shared-border-width);
    border-bottom-color: var(--skeuo-paper-rule);
    min-height: var(--skeuo-shared-row-height);
}
