/* Seal Element — USS (AC-42-C2 / AC-42-C5) */

.seal {
    /* 2026-10-05 019-d 接图:引 seal_surface-final.png(印面石材质 —— 容器底)。
       ⚠️ 用 seal_surface 而非 seal_red:seal_red 是「盖章后的印泥痕迹」(叠加层语义),
       本类是**容器底**。 */
    background-image: url("guid:86de93e30c2c97f4fb72f7be67352444");
    background-color: var(--skeuo-seal-bg);
    border-top-width: var(--skeuo-seal-border-width);
    border-right-width: var(--skeuo-seal-border-width);
    border-bottom-width: var(--skeuo-seal-border-width);
    border-left-width: var(--skeuo-seal-border-width);
    border-top-color: var(--skeuo-seal-border);
    border-right-color: var(--skeuo-seal-border);
    border-bottom-color: var(--skeuo-seal-border);
    border-left-color: var(--skeuo-seal-border);
    border-top-left-radius: var(--skeuo-seal-radius);
    border-top-right-radius: var(--skeuo-seal-radius);
    border-bottom-right-radius: var(--skeuo-seal-radius);
    border-bottom-left-radius: var(--skeuo-seal-radius);
    color: var(--skeuo-seal-fg);
    font-family: var(--skeuo-font-family);
    font-size: var(--skeuo-font-size-lg);
    padding-top: var(--skeuo-shared-space-sm);
    padding-right: var(--skeuo-shared-space-sm);
    padding-bottom: var(--skeuo-shared-space-sm);
    padding-left: var(--skeuo-shared-space-sm);
    -unity-slice-left: 8px;
    -unity-slice-right: 8px;
    -unity-slice-top: 8px;
    -unity-slice-bottom: 8px;
}

.seal-small {
    font-size: var(--skeuo-font-size-md);
}
